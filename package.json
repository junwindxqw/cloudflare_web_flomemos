{
  "name": "flomemos",
  "version": "1.2.0",
  "description": "Flomemos — flomo 风格的轻量级笔记应用，部署在 Cloudflare 免费档（Workers + D1 + R2）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"fs.rmSync('public/.mimosa',{recursive:true,force:true})\" && wrangler deploy",
    "tail": "wrangler tail",
    "db:init-local": "wrangler d1 execute flomemos --local --file=./schema.sql",
    "db:init-remote": "wrangler d1 execute flomemos --remote --file=./schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node scripts/capture.mjs"
  },
  "keywords": [
    "flomo",
    "memos",
    "notes",
    "cloudflare",
    "workers",
    "d1",
    "r2",
    "free-tier"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.9.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
