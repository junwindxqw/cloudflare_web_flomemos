{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flomemos",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flomemos"
      // 不写 database_id：wrangler 与「Deploy to Cloudflare」一键部署都会自动创建并绑定资源；
      // 如需手动指定，先 `npx wrangler d1 create flomemos`，再把返回的 id 填在这里。
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "flomemos-files"
    }
  ],
  "vars": {
    "AUTH_USERNAME": "",
    "AUTH_PASSWORD": ""
  }
}
