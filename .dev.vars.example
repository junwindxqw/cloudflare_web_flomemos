# 本地开发用的环境变量示例。复制为 .dev.vars（已被 .gitignore 忽略，不会提交）。

# Resend 邮件服务的 API Key（https://resend.com 免费注册），用于发送注册/找回密码验证码。
# 不配置时：开发环境可配合 DEV_EXPOSE_CODE=1 跳过真实发信；生产环境注册/找回功能会返回明确错误。
# RESEND_API_KEY=re_xxxxxxxx

# 发件人显示，如：Flomemos <noreply@yourdomain.com>（域名需在 Resend 完成验证）。
# 未配置时使用 Resend 沙箱发件人（只能投递到 Resend 账号本人邮箱）。
# MAIL_FROM=Flomemos <noreply@yourdomain.com>

# 开发开关：跳过真实发信，把验证码直接返回在接口响应里（生产环境绝对不要开启！）
DEV_EXPOSE_CODE=1
